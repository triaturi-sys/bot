# Gmail account yang menerima forward email dari Cloudflare
GMAIL_EMAIL=youremail@gmail.com

# Gmail App Password (16 karakter, dari https://myaccount.google.com/apppasswords)
# JANGAN pakai password Gmail asli!
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Domain kamu (yang sudah setup Cloudflare Email Routing)
DOMAIN=bookinglapanganfutsal.my.id

# Interval polling Gmail (detik). Default: 15 detik
POLL_INTERVAL=15

# Secret key Flask (ganti dengan random string panjang)
SECRET_KEY=ganti-dengan-random-string-yang-panjang
